---
import { ui, type Lang } from '../i18n/ui';
import { profile } from '../data/profile';
import Section from './Section.astro';
import SocialLinks from './SocialLinks.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].contact;
const field =
  'mt-1 w-full rounded-lg border border-border bg-bg px-3 py-2.5 text-text placeholder:text-muted focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30';
---

<Section id="contact" title={t.title}>
  <div class:list={['grid gap-10 rounded-3xl border border-border bg-surface p-6 sm:p-10', profile.formEndpoint && 'md:grid-cols-2']}>
    <div>
      <p class="text-lg leading-relaxed text-muted">{t.text}</p>
      <a
        href={`mailto:${profile.email}`}
        class="mt-6 inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-3 font-semibold text-accent-fg transition hover:opacity-90"
      >
        {t.emailMe}
      </a>
      <p class="mt-3 text-sm text-muted">{profile.email}</p>
      <div class="mt-6 -ml-2">
        <SocialLinks size="md" />
      </div>
    </div>

    {
      profile.formEndpoint && (
        <form action={profile.formEndpoint} method="POST" class="space-y-4">
          <label class="block text-sm font-medium">
            {t.name}
            <input name="name" type="text" required autocomplete="name" class={field} />
          </label>
          <label class="block text-sm font-medium">
            {t.email}
            <input name="email" type="email" required autocomplete="email" class={field} />
          </label>
          <label class="block text-sm font-medium">
            {t.message}
            <textarea name="message" rows="5" required class={field} />
          </label>
          <button
            type="submit"
            class="w-full rounded-lg border border-border bg-bg px-5 py-3 font-semibold transition hover:border-accent hover:text-accent"
          >
            {t.send}
          </button>
        </form>
      )
    }
  </div>
</Section>
