---
import { ui, type Lang } from '../i18n/ui';
import { profile } from '../data/profile';
import SocialLinks from './SocialLinks.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 px-4 py-8 text-sm text-muted sm:flex-row sm:px-6">
    <p class="text-center sm:text-left">© {year} {profile.name}. {ui[lang].footer}</p>
    <SocialLinks />
  </div>
</footer>
