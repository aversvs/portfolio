---
interface Props {
  id: string;
  title: string;
  subtitle?: string;
}

const { id, title, subtitle } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-20">
  <h2 id={`${id}-title`} class="text-2xl font-bold tracking-tight sm:text-3xl">{title}</h2>
  {subtitle && <p class="mt-3 max-w-2xl text-muted">{subtitle}</p>}
  <div class="mt-8 sm:mt-10">
    <slot />
  </div>
</section>
