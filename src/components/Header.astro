---
import { homePath, otherLang, ui, type Lang } from '../i18n/ui';
import { profile } from '../data/profile';

interface Props {
  lang: Lang;
  altHref: string;
}

const { lang, altHref } = Astro.props;
const t = ui[lang];
const home = homePath(lang);
const links = [
  { href: `${home}#projects`, label: t.nav.projects },
  { href: `${home}#skills`, label: t.nav.skills },
  { href: `${home}#experience`, label: t.nav.experience },
  { href: `${home}#contact`, label: t.nav.contact },
];
const initials = profile.name
  .split(' ')
  .map((part) => part[0])
  .slice(0, 2)
  .join('');
---

<header class="sticky top-0 z-40 border-b border-border/60 bg-bg/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href={home} class="flex items-center gap-2 font-semibold tracking-tight" aria-label={profile.name}>
      <span class="grid size-8 place-items-center rounded-lg bg-accent text-sm text-accent-fg">{initials}</span>
      <span class="hidden sm:inline">{profile.name}</span>
    </a>

    <nav aria-label={t.nav.main} class="hidden md:block">
      <ul class="flex items-center gap-1 text-sm">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="rounded-md px-3 py-2 text-muted transition-colors hover:bg-surface hover:text-text"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <a
        href={altHref}
        hreflang={otherLang(lang)}
        lang={otherLang(lang)}
        title={t.switchLang}
        aria-label={t.switchLang}
        class="rounded-md px-3 py-2 text-sm font-medium text-muted uppercase transition-colors hover:bg-surface hover:text-text"
      >
        {otherLang(lang)}
      </a>
      <button
        type="button"
        data-theme-toggle
        aria-label={t.theme}
        title={t.theme}
        class="grid size-9 place-items-center rounded-md text-muted transition-colors hover:bg-surface hover:text-text"
      >
        <svg class="size-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
        <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path stroke-linecap="round" d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>

      <details class="relative md:hidden" data-mobile-menu>
        <summary
          class="grid size-9 cursor-pointer list-none place-items-center rounded-md text-muted hover:bg-surface hover:text-text [&::-webkit-details-marker]:hidden"
          aria-label={t.nav.menu}
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </summary>
        <nav
          aria-label={t.nav.menu}
          class="absolute right-0 mt-2 w-52 rounded-xl border border-border bg-surface p-2 shadow-lg"
        >
          <ul>
            {
              links.map((link) => (
                <li>
                  <a href={link.href} class="block rounded-md px-3 py-2 text-sm hover:bg-bg">
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  toggle?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {}
  });

  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => menu.removeAttribute('open'));
  });
  document.addEventListener('click', (event) => {
    if (menu?.open && !menu.contains(event.target as Node)) menu.removeAttribute('open');
  });
</script>
